# Nod.ie Environment Configuration

# Assistant Settings
ASSISTANT_NAME=Nodie

# Service Hosts (for distributed deployments)
# Example: MUSETALK_HOST=192.168.1.100 or MUSETALK_HOST=musetalk.example.com
UNMUTE_BACKEND_HOST=localhost
UNMUTE_MCP_BACKEND_HOST=localhost
MUSETALK_HOST=localhost

# Port Configuration
UNMUTE_BACKEND_PORT=8767
UNMUTE_MCP_BACKEND_PORT=8766
MUSETALK_PORT=8765
WEB_TEST_PORT=8095

# WebSocket URLs (constructed from host:port or override completely)
UNMUTE_BACKEND_URL=ws://localhost:8767
UNMUTE_MCP_BACKEND_URL=ws://localhost:8766
MUSETALK_URL=ws://localhost:8765
MUSETALK_WS=ws://localhost:8765/ws

# HTTP URLs (constructed from host:port or override completely)
UNMUTE_BACKEND_HTTP=http://localhost:8767
UNMUTE_MCP_BACKEND_HTTP=http://localhost:8766
MUSETALK_HTTP=http://localhost:8765

# Voice Configuration
VOICE_MODEL=unmute-prod-website/ex04_narration_longform_00001.wav

# LLM Configuration
LLM_MODEL=llama3.2:3b

# Avatar Configuration
AVATAR_VIDEO_PATH=/app/avatars/nodie-video-03.mp4

# Integration Settings
N8N_WEBHOOK_URL=

# UI Configuration
GLOBAL_HOTKEY=CommandOrControl+Shift+Space
# Select realtime (Unmute) or local (push-to-talk).
VOICE_MODE=local
AVATAR_ENABLED=false
LOCAL_STT_URL=http://127.0.0.1:8100
LOCAL_STT_MODEL=Systran/faster-whisper-tiny.en
LOCAL_TTS_URL=http://127.0.0.1:8104
LOCAL_TTS_VOICE=af_heart
LOCAL_TTS_SPEED=1.06
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:9b
# Optional: existing MCP configuration containing Neo4j connection credentials.
REVERIE_CONFIG_PATH=
REVERIE_CONFIG_SERVER=

# Optional local neural lip-sync service; blank keeps audio-only replies.
LOCAL_LIP_SYNC_URL=
# After setup: LOCAL_LIP_SYNC_URL=http://127.0.0.1:8768
